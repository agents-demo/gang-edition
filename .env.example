# Copy to .env in the project root. It is loaded by the CLI automatically.
# Leave the key empty for the offline demo. Never commit .env or share the key.
GANG_LLM_API_KEY=
# OpenAI-compatible API root. The app appends /chat/completions itself.
# Change only to a provider you trust with the candidate chat text.
# DeepSeek example: https://api.deepseek.com  (also accepts /v1)
GANG_LLM_BASE_URL=https://api.deepseek.com
GANG_LLM_MODEL=deepseek-flash
# Local-model example: http://127.0.0.1:11434/v1
# For a compatible local server requiring a placeholder key, use its documented value.

# Telegram: token from @BotFather (/newbot). Required only for `telegram-run`.
# Also in BotFather: /setprivacy -> Disable, so the bot can read group messages.
TELEGRAM_BOT_TOKEN=
# Optional: voice transcription model for the cloud path (/audio/transcriptions at the same base URL).
GANG_TRANSCRIBE_MODEL=whisper-1
# Optional: days of group text kept on disk (default 35).
GANG_RETENTION_DAYS=35

# Optional: image generation via OpenRouter. Leave the key empty to draw locally.
# With a key set and everyone opted in to /cloudok, /comic cloud uses this model.
GANG_IMG_API_KEY=
GANG_IMG_BASE_URL=https://openrouter.ai/api/v1
GANG_IMG_MODEL=bytedance-seed/seedream-5-0-pro
# full = the model draws the whole page (including text). hybrid = model draws the
# background, Pillow overlays accurate panels/text.
GANG_IMG_MODE=full
GANG_IMG_RESOLUTION=2K
GANG_IMG_ASPECT_RATIO=2:3

# Optional: default comic style (marvel, dc, ghibli, or cartoon). Default: marvel.
GANG_DEFAULT_STYLE=marvel
